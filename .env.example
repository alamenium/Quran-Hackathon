# --- Quran Foundation Content APIs (optional) ---
# Get credentials at https://api-docs.quran.foundation/request-access/
# If left blank, the app uses the bundled offline dataset (works for the demo).
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# Use "prelive" while developing, "production" for live deployments
QF_ENV=prelive

# --- Server ---
PORT=4000
NODE_ENV=development

# --- ASR sidecar ---
# URL of the DeepSpeech-Quran Python service. Defaults to localhost:5005,
# which is right when you run `python asr_service/main.py` alongside the
# Node server. In docker-compose, set this to http://asr:5005 (already
# done in docker-compose.yml).
ASR_URL=http://localhost:5005

# --- Client ---
# Where the React app should send API calls. Leave default for local dev.
VITE_API_URL=http://localhost:4000
