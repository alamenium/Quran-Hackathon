# --- Quran Foundation Content APIs (optional) ---
# Get credentials at https://api-docs.quran.foundation/request-access/
# If left blank, the app uses the bundled offline dataset (works for the demo).
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# Use "prelive" while developing, "production" for live deployments
QF_ENV=prelive

# --- Quran Foundation Content API defaults (optional) ---
# IDs from /resources/translations, /resources/tafsirs, /resources/recitations.
# Defaults below pick widely-used, child-appropriate resources.
QF_TRANSLATION_ID=131
QF_TAFSIR_ID=169
QF_RECITER_ID=7
QF_MUSHAF_ID=5

# --- Quran Foundation User APIs (optional) ---
# User-related APIs use OAuth2 Authorization Code (user auth), not the
# client_credentials grant above. For a hackathon demo, leave these blank
# and the app uses the local/Firebase fallback provider automatically.
# When set, the app routes /api/user/* through Quran Foundation.
#   https://api-docs.quran.foundation/docs/user_related_apis_versioned/1.0.0/user-related-apis/
QF_USER_ACCESS_TOKEN=
QF_USER_CLIENT_ID=
# Optional override; otherwise computed from QF_ENV.
QF_USER_API_BASE_URL=
QF_REDIRECT_URI=

# --- Gemini AI (optional but recommended) ---
# Get a key at https://aistudio.google.com/
# Without this, the AI tutor returns a graceful "not available" message
# and lesson summaries fall back to a template. Everything else still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Firebase / Firestore (optional) ---
# Get service account credentials from Firebase Console > Project settings > Service accounts.
# Without these, the app stores user progress in server/data/users.json (fine for dev/demo).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

PORT=4000
NODE_ENV=development

# --- ASR sidecar ---
# URL of the faster-whisper Python service in asr_service/.
# Defaults to localhost:5005, which is right when you run
# `npm run dev:asr` (or `python asr_service/main.py`) alongside the Node
# server. In docker-compose this is overridden to http://asr:5005.
ASR_URL=http://localhost:5005

# Whisper model size: tiny | base | small | medium | large-v2 | large-v3
# `small` is fast and fine for development; `medium` is the recommended
# default for production (better accuracy on Quranic Arabic).
ASR_MODEL_SIZE=small

# --- Client ---
# Where the React app should send API calls. Leave default for local dev.
VITE_API_URL=http://localhost:4000
